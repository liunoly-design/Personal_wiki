{
  "id": "personal-wiki",
  "name": "Personal Wiki",
  "description": "Record explicit 小婕 wk Feishu links, save Flash foundations, then compile with nashsu.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": false
      },
      "accountId": {
        "type": "string"
      },
      "entryAgentId": {
        "type": "string"
      },
      "allowedSenderIds": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^ou_[A-Za-z0-9_-]+$"
        }
      },
      "allowedConversationIds": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^oc_[A-Za-z0-9_-]+$"
        }
      },
      "vault": {
        "type": "string",
        "pattern": "^/"
      },
      "stateDir": {
        "type": "string",
        "pattern": "^/"
      },
      "python": {
        "type": "string",
        "pattern": "^/"
      },
      "flashModel": {
        "type": "string",
        "default": "gemini-flash-latest"
      },
      "codexBinary": {
        "type": "string",
        "pattern": "^/"
      },
      "compilerModel": {
        "type": "string",
        "default": "gpt-6-sol"
      },
      "wikiAgentId": {
        "type": "string",
        "default": "wiki"
      },
      "flashProxyUrl": {
        "type": "string",
        "pattern": "^https?://",
        "description": "Optional proxy for Wiki Flash requests only; no global proxy changes."
      },
      "publishSources": {
        "type": "boolean",
        "default": false,
        "description": "Publish full text in raw/sources/collected after the nashsu watcher exclusion is applied."
      },
      "canonicalLibrary": {
        "type": "boolean",
        "default": false,
        "description": "Use canonical nashsu library, durable tasks and native API verification."
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "enabled": {
              "const": true
            }
          },
          "required": [
            "enabled"
          ]
        },
        "then": {
          "required": [
            "accountId",
            "entryAgentId",
            "allowedSenderIds",
            "allowedConversationIds",
            "vault",
            "stateDir",
            "python"
          ]
        }
      }
    ]
  },
  "contracts": {
    "tools": [
      "wiki_record",
      "wiki_status",
      "wiki_retry_translation",
      "wiki_resume"
    ]
  }
}
