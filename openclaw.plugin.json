{
  "id": "personal-wiki",
  "name": "Personal Wiki",
  "description": "Scoped Feishu collection, evidence query, discussion, conclusion and protected synthesis Review.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": false
      },
      "accountId": {
        "type": "string"
      },
      "entryAgentId": {
        "type": "string"
      },
      "allowedSenderIds": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^ou_[A-Za-z0-9_-]+$"
        }
      },
      "allowedConversationIds": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^oc_[A-Za-z0-9_-]+$"
        }
      },
      "vault": {
        "type": "string",
        "pattern": "^/"
      },
      "stateDir": {
        "type": "string",
        "pattern": "^/"
      },
      "python": {
        "type": "string",
        "pattern": "^/"
      },
      "flashModel": {
        "type": "string",
        "default": "gemini-flash-latest"
      },
      "codexBinary": {
        "type": "string",
        "pattern": "^/"
      },
      "compilerModel": {
        "type": "string",
        "default": "gpt-6-sol"
      },
      "wikiAgentId": {
        "type": "string",
        "default": "wiki"
      },
      "flashProxyUrl": {
        "type": "string",
        "pattern": "^https?://",
        "description": "Optional proxy for Wiki Flash requests only; no global proxy changes."
      },
      "publishSources": {
        "type": "boolean",
        "default": false,
        "description": "Publish full text in raw/sources/collected after the nashsu watcher exclusion is applied."
      },
      "canonicalLibrary": {
        "type": "boolean",
        "default": false,
        "description": "Use canonical nashsu library, durable tasks and native API verification."
      },
      "asrBinary": {
        "type": "string",
        "pattern": "^/",
        "description": "Pinned codex-asr 0.1.2 executable for explicitly authorized Douyin cloud transcription; no paid fallback."
      },
      "mediaServiceUrl": {
        "type": "string",
        "pattern": "^https?://",
        "description": "LAN v1 media service for Douyin; no local fallback when configured."
      },
      "mediaServiceTokenFile": {
        "type": "string",
        "pattern": "^/",
        "description": "Owned private file containing media service token; never inline credentials."
      },
      "nashsuStatePath": {
        "type": "string",
        "pattern": "^/",
        "description": "Optional explicit local nashsu state; fixed Vault registration is still verified."
      },
      "openclawPackageDir": {
        "type": "string",
        "pattern": "^/",
        "description": "Optional installed OpenClaw package for credential and proxy resolution."
      },
      "strictFeishuAccount": {
        "type": "boolean",
        "default": false,
        "description": "Require the selected named account to own its credentials; independent installs enable this."
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "enabled": {
              "const": true
            }
          },
          "required": [
            "enabled"
          ]
        },
        "then": {
          "required": [
            "accountId",
            "entryAgentId",
            "allowedSenderIds",
            "allowedConversationIds",
            "vault",
            "stateDir",
            "python"
          ]
        }
      }
    ]
  },
  "contracts": {
    "tools": [
      "wiki_record",
      "wiki_status",
      "wiki_retry_translation",
      "wiki_resume",
      "wiki_query",
      "wiki_read",
      "wiki_review",
      "wiki_discuss"
    ]
  }
}
